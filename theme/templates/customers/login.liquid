<div class="page-width page-width--narrow" style="padding-block: 6rem 10rem; max-width: 46rem;">
  <h1 class="text-center">{{ 'customer.login_page.title' | t }}</h1>

  {%- form 'customer_login', novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <p class="form__message">{{ form.errors | default_errors }}</p>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="CustomerEmail">{{ 'customer.login_page.email' | t }}</label>
      <input class="field__input" id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required>
    </div>

    {%- if form.password_needed -%}
      <div class="field">
        <label class="field__label" for="CustomerPassword">{{ 'customer.login_page.password' | t }}</label>
        <input class="field__input" id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password">
      </div>
      <a class="link" href="#recover">{{ 'customer.login_page.forgot_password' | t }}</a>
    {%- endif -%}

    <button type="submit" class="button button--full" style="margin-top:2rem;">{{ 'customer.login_page.sign_in' | t }}</button>
  {%- endform -%}

  <p class="text-center" style="margin-top:2.4rem;">
    <a class="link" href="{{ routes.account_register_url }}">{{ 'customer.login_page.create_account' | t }}</a>
  </p>

  <div id="recover" style="margin-top:5rem;">
    <h2 class="h3">{{ 'customer.recover_password.title' | t }}</h2>
    <p class="text-muted">{{ 'customer.recover_password.subtext' | t }}</p>
    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}
        <p class="form__message form__message--success">{{ 'customer.recover_password.success' | t }}</p>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="RecoverEmail">{{ 'customer.login_page.email' | t }}</label>
        <input class="field__input" id="RecoverEmail" type="email" name="email" autocomplete="email" required>
      </div>
      <button type="submit" class="button button--secondary">{{ 'customer.recover_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
