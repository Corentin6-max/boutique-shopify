<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="image-with-text {% if section.settings.image_position == 'right' %}image-with-text--reverse{% endif %}">
      <div class="image-with-text__media media {{ section.settings.image_ratio }}">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="image-with-text__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- when 'heading' -%}
              <h2 {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
            {%- when 'text' -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'list' -%}
              <ul class="stack" style="margin: 2rem 0;" {{ block.shopify_attributes }}>
                {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for item in items -%}
                  {%- if item != blank -%}
                    <li style="display:flex;gap:1.2rem;align-items:flex-start;">
                      <span style="color:var(--color-accent);flex:0 0 auto;">{% render 'icon', icon: 'sparkle', size: 20 %}</span>
                      <span>{{ item | strip }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- when 'button' -%}
              <a class="button" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
                {{ block.settings.label }}
              </a>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-image-with-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [
      { "value": "media--square", "label": "Square" }, { "value": "media--portrait", "label": "Portrait" },
      { "value": "media--landscape", "label": "Landscape" }
    ], "default": "media--square" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [
      { "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" },
      { "value": "soft", "label": "Soft accent" }, { "value": "accent", "label": "Accent" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Notre sélection" }] },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "On teste avant de vendre" }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Chaque produit passe par nos propres animaux pendant plusieurs semaines avant d'entrer au catalogue.</p>" }] },
    { "type": "list", "name": "Checklist", "settings": [{ "type": "textarea", "id": "items", "label": "One item per line", "default": "Silicone alimentaire, acier inoxydable, caoutchouc non toxique\nDes tailles pour les petits comme les grands gabarits\nDes pièces de rechange disponibles" }] },
    { "type": "button", "name": "Button", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Voir la boutique" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }, { "type": "list" }, { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
