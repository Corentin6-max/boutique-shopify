{%- comment -%} Generic image + text columns — used for ingredients, values, press. {%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="grid grid--{{ section.settings.columns }} grid--2-mobile">
      {%- for block in section.blocks -%}
        <div class="{% if section.settings.card_style %}testimonial{% endif %}" style="{% unless section.settings.card_style %}display:flex;flex-direction:column;gap:1.2rem;{% endunless %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="media {{ section.settings.image_ratio }}" {% if section.settings.round_images %}style="border-radius:50%;max-width:16rem;margin:0 auto;"{% endif %}>
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | escape }}" width="400" height="400" loading="lazy">
            </div>
          {%- endif -%}
          <h3 class="h4" style="margin:0;{% if section.settings.text_align == 'center' %}text-align:center;{% endif %}">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <div class="rte text-muted" style="font-size:1.45rem;{% if section.settings.text_align == 'center' %}text-align:center;{% endif %}">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a class="link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Multi-column",
  "class": "section-multicolumn",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nos engagements" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ce qu'on vérifie avant de vendre" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [
      { "value": "media--square", "label": "Square" }, { "value": "media--portrait", "label": "Portrait" },
      { "value": "media--landscape", "label": "Landscape" }
    ], "default": "media--square" },
    { "type": "checkbox", "id": "round_images", "label": "Round images", "default": false },
    { "type": "checkbox", "id": "card_style", "label": "Show as cards", "default": false },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [
      { "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" },
      { "value": "soft", "label": "Soft accent" }, { "value": "band", "label": "Neutral band" }, { "value": "accent", "label": "Accent" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Matériaux sûrs" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Silicone alimentaire, acier inoxydable 304, caoutchouc non toxique.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi-column",
      "blocks": [
        { "type": "column", "settings": { "title": "Matériaux sûrs", "text": "<p>Silicone alimentaire, acier inoxydable 304, caoutchouc non toxique.</p>" } },
        { "type": "column", "settings": { "title": "Solidité testée", "text": "<p>Plusieurs semaines d'usage réel avant d'entrer au catalogue.</p>" } },
        { "type": "column", "settings": { "title": "Entretien facile", "text": "<p>Pièces démontables, passage au lave-vaisselle quand c'est possible.</p>" } }
      ]
    }
  ]
}
{% endschema %}
