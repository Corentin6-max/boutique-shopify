{%- comment -%} Host section for app blocks (reviews, upsells, subscriptions...). {%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width {% if section.settings.narrow %}page-width--medium{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="section-header"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Apps",
  "class": "section-apps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow width", "default": false },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [
      { "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" },
      { "value": "soft", "label": "Soft accent" }, { "value": "accent", "label": "Accent" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 60 }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Apps" }]
}
{% endschema %}
