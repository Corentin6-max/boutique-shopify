{%- liquid
  assign featured = section.settings.product
-%}
<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="product" style="padding-block:0;" data-product-gallery>
      <div class="product__media-wrapper" style="position:static;">
        <div class="product__media-main media">
          {%- if featured.media.size > 0 -%}
            {%- for media in featured.media limit: 4 -%}
              <div class="product__media-item {% if forloop.first %}is-active{% endif %}" data-media-item="{{ media.id }}">
                <img
                  src="{{ media | image_url: width: 1200 }}"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.width }}"
                  height="{{ media.height }}"
                  loading="lazy">
              </div>
            {%- endfor -%}
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if featured.media.size > 1 -%}
          <div class="product__thumbs">
            {%- for media in featured.media limit: 4 -%}
              <button type="button" class="product__thumb {% if forloop.first %}is-active{% endif %}" data-media-id="{{ media.id }}" aria-label="{{ 'products.product.media_gallery' | t }} {{ forloop.index }}">
                <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" width="80" height="80" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}

        <h2 class="product__title h1">
          {%- if featured != blank -%}{{ featured.title }}{%- else -%}{{ section.settings.heading }}{%- endif -%}
        </h2>

        {%- if section.settings.show_rating -%}
          <div class="product__meta">
            {% render 'rating', product: featured, show_count: true, fallback_rating: 5, fallback_count: 0 %}
            <span class="text-muted" style="font-size:1.35rem;">{{ section.settings.rating_text }}</span>
          </div>
        {%- endif -%}

        {%- if featured != blank -%}
          <div class="product__price" data-price-target>
            {% render 'price', product: featured, use_variant: true, show_badges: true %}
          </div>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte" style="margin-bottom:2.4rem;">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.benefits != blank -%}
          <ul class="stack" style="margin-bottom:2.4rem;">
            {%- assign lines = section.settings.benefits | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- if line != blank -%}
                <li style="display:flex;gap:1rem;align-items:flex-start;font-size:1.5rem;">
                  <span style="color:var(--color-accent);flex:0 0 auto;">{% render 'icon', icon: 'sparkle', size: 20 %}</span>
                  <span>{{ line | strip }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if featured != blank -%}
          {% render 'product-form',
            product: featured,
            section_id: section.id,
            show_quantity: section.settings.show_quantity,
            show_dynamic_checkout: section.settings.show_dynamic_checkout,
            button_label: section.settings.button_label %}

          {%- if section.settings.show_view_link -%}
            <a class="link" href="{{ featured.url }}">{{ 'products.product.view_details' | t }}</a>
          {%- endif -%}
        {%- else -%}
          <p class="text-muted">{{ 'onboarding.product_title' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "class": "section-featured-product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Le coup de cœur" },
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "Votre produit phare" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Le produit que nos clients recommandent le plus souvent.</p>" },
    { "type": "textarea", "id": "benefits", "label": "Benefit list (one per line)", "default": "Clears build-up without stripping\nCalms itch and flaking\nTesté par notre équipe" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Avis vérifiés" },
    { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true },
    { "type": "checkbox", "id": "show_view_link", "label": "Show link to the product page", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [
      { "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" },
      { "value": "soft", "label": "Soft accent" }, { "value": "accent", "label": "Accent" }
    ], "default": "surface" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
