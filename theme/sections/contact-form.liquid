<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width page-width--narrow">
    <div class="section-header">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}
        <p class="form__message form__message--success">{{ 'sections.contact.post_success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form__message">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="grid grid--2">
        <div class="field">
          <label class="field__label" for="ContactName">{{ 'sections.contact.name' | t }}</label>
          <input class="field__input" id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name">
        </div>
        <div class="field">
          <label class="field__label" for="ContactEmail">{{ 'sections.contact.email' | t }}</label>
          <input class="field__input" id="ContactEmail" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="ContactPhone">{{ 'sections.contact.phone' | t }}</label>
        <input class="field__input" id="ContactPhone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
      </div>
      <div class="field">
        <label class="field__label" for="ContactBody">{{ 'sections.contact.message' | t }}</label>
        <textarea id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button button--large">{{ 'sections.contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Écrivez-nous" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>On répond à chaque message sous 24 h ouvrées, du lundi au vendredi.</p>" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [
      { "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" },
      { "value": "soft", "label": "Soft accent" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
