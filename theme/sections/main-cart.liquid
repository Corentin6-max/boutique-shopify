<div class="page-width" style="padding-block: 5rem 8rem;">
  <h1 style="margin-bottom:3rem;">{{ 'sections.cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="text-center" style="padding:6rem 0;">
      <h2>{{ 'sections.cart.empty' | t }}</h2>
      <p class="text-muted">{{ 'sections.cart.empty_subtext' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    {% render 'shipping-bar' %}

    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <table class="cart-items">
        <thead>
          <tr>
            <th>{{ 'sections.cart.product' | t }}</th>
            <th>{{ 'sections.cart.quantity' | t }}</th>
            <th style="text-align:right;">{{ 'sections.cart.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr class="cart-item">
              <td>
                <div style="display:flex;gap:2rem;">
                  <a href="{{ item.url }}" class="cart-item__media media media--square" style="flex:0 0 9rem;">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.image.alt | escape }}" width="90" height="90" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div>
                    <a class="cart-item__name" href="{{ item.url }}">{{ item.product.title }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      <div class="cart-item__options">{{ item.variant.title }}</div>
                    {%- endunless -%}
                    {%- if item.selling_plan_allocation -%}
                      <div class="cart-item__options">{{ item.selling_plan_allocation.selling_plan.name }}</div>
                    {%- endif -%}
                    {%- for property in item.properties -%}
                      {%- unless property.last == blank or property.first[0] == '_' -%}
                        <div class="cart-item__options">{{ property.first }}: {{ property.last }}</div>
                      {%- endunless -%}
                    {%- endfor -%}
                    <div class="cart-item__options">{{ item.original_price | money }}</div>
                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      {%- for discount in item.line_level_discount_allocations -%}
                        <div class="cart-item__options" style="color:var(--color-sale);">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</div>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                </div>
              </td>
              <td>
                {% render 'quantity-input', id: 'CartQty-', value: item.quantity, line: forloop.index %}
                <button type="button" class="link" data-cart-remove="{{ forloop.index }}" style="margin-top:1rem;display:block;font-size:1.3rem;">
                  {{ 'sections.cart.remove' | t }}
                </button>
              </td>
              <td style="text-align:right;font-weight:600;">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div class="cart__footer">
        <div>
          {%- if settings.cart_show_note -%}
            <label class="field__label" for="CartNote">{{ 'sections.cart.note' | t }}</label>
            <textarea id="CartNote" name="note" placeholder="{{ 'sections.cart.note_placeholder' | t }}">{{ cart.note }}</textarea>
          {%- endif -%}
        </div>

        <div>
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart__totals" style="font-size:1.5rem;color:var(--color-sale);">
                <span>{{ discount.title }}</span>
                <span>-{{ discount.total_allocated_amount | money }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}

          <div class="cart__totals">
            <span>{{ 'sections.cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <p class="cart__tax">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>

          <button type="submit" name="update" class="button button--secondary button--full" style="margin-bottom:1rem;">
            {{ 'sections.cart.update' | t }}
          </button>
          <button type="submit" name="checkout" class="button button--full button--large">
            {{ 'sections.cart.checkout' | t }}
          </button>

          {%- if additional_checkout_buttons -%}
            <div style="margin-top:1.6rem;">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </div>
    </form>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "class": "section-main-cart" }
{% endschema %}
