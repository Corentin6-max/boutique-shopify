{%- comment -%}
  Section à cartes réutilisable — sert aussi bien au bloc « problème » qu'au
  bloc « bénéfices ». Le nombre de colonnes s'adapte au nombre de blocs.
{%- endcomment -%}
{%- liquid
  assign count = section.blocks.size
  assign cols = '3'
  if count == 4 or count >= 5
    assign cols = '4'
  endif
-%}
<div class="sw sw-block{% if section.settings.band %} sw-block--band{% endif %}">
  <div class="sw__wrap">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="sw__section-head{% if section.settings.centered %} sw__section-head--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sw__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sw__h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="sw__lede">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sw-cards sw-cards--{{ cols }}">
      {%- for block in section.blocks -%}
        <article class="sw-card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="sw-card__icon">{% render 'sw-icon', icon: block.settings.icon %}</span>
          {%- endif -%}
          <h3 class="sw-card__title">{{ block.settings.title }}</h3>
          <div class="sw-card__text">{{ block.settings.text }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cartes Shapewear",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "centered", "label": "Titre centré", "default": false },
    { "type": "checkbox", "id": "band", "label": "Fond gris", "default": false }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Carte",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône", "default": "check",
          "options": [
            { "value": "check", "label": "Coche" },
            { "value": "arrows-in", "label": "Compression" },
            { "value": "spine", "label": "Dos / posture" },
            { "value": "eye-off", "label": "Invisible" },
            { "value": "wind", "label": "Respirant" },
            { "value": "layers", "label": "Matière" },
            { "value": "ruler", "label": "Taille" },
            { "value": "clock", "label": "Durée" },
            { "value": "truck", "label": "Livraison" },
            { "value": "rotate", "label": "Retour" },
            { "value": "shield", "label": "Garantie" },
            { "value": "sparkle", "label": "Étoile" }
          ]
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Titre de la carte" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Décrivez le bénéfice en une ou deux phrases.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Cartes Shapewear" }]
}
{% endschema %}
