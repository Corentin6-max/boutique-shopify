<div class="page-width page-width--narrow text-center" style="padding-block: 12rem;">
  {%- if settings.logo != blank -%}
    <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="180" height="40" style="margin:0 auto 3rem;">
  {%- else -%}
    <img src="{{ 'logo-velluno.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="200" height="42" style="margin:0 auto 3rem;">
  {%- endif -%}

  <h1>{{ section.settings.heading }}</h1>
  <div class="rte" style="margin-bottom:3rem;">{{ section.settings.text }}</div>

  {%- form 'customer', class: 'newsletter__form' -%}
    <input type="hidden" name="contact[tags]" value="prospect, password page">
    <div class="field">
      <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
      <input class="field__input" id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}" required>
    </div>
    <button type="submit" class="button">{{ 'general.newsletter_form.button_label' | t }}</button>
    {%- if form.posted_successfully? -%}
      <p class="form__message form__message--success">{{ 'general.newsletter_form.confirmation' | t }}</p>
    {%- endif -%}
  {%- endform -%}

  <details style="margin-top:5rem;">
    <summary class="link">Enter using password</summary>
    <div style="max-width:32rem;margin:2rem auto 0;">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p class="form__message">{{ form.errors.messages.form }}</p>
        {%- endif -%}
        <div class="field">
          <label class="visually-hidden" for="StorefrontPassword">Password</label>
          <input class="field__input" id="StorefrontPassword" type="password" name="password" autocomplete="current-password">
        </div>
        <button type="submit" class="button button--full">Enter</button>
      {%- endform -%}
    </div>
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ça ouvre bientôt" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Laissez votre e-mail pour être prévenu du lancement — et recevoir 10% sur votre première commande.</p>" }
  ]
}
{% endschema %}
