{%- comment -%}
  Numbered product cards: one card per step of the routine, each linking to its
  own product page. Image and link come from the selected product unless
  overridden on the block.
{%- endcomment -%}
<section class="section ritual scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="ritual__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ritual__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ritual__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="ritual__grid" style="--ritual-columns: {{ section.blocks.size | at_least: 1 | at_most: 6 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign step_product = block.settings.product

          assign step_title = block.settings.title
          if step_title == blank
            assign step_title = step_product.title
          endif

          assign step_text = block.settings.text
          if step_text == blank
            assign step_text = step_product.description | strip_html | truncatewords: 22
          endif

          assign step_url = block.settings.link
          if step_url == blank
            assign step_url = step_product.url
          endif

          assign step_link_label = block.settings.link_label
          if step_link_label == blank
            assign step_link_label = section.settings.link_label
          endif

          assign step_image = block.settings.image
          if step_image == blank
            assign step_image = step_product.featured_image
          endif
        -%}
        <article class="ritual-card" {{ block.shopify_attributes }}>
          <div class="ritual-card__media">
            {%- if step_image != blank -%}
              <img
                src="{{ step_image | image_url: width: 600 }}"
                srcset="{{ step_image | image_url: width: 300 }} 300w, {{ step_image | image_url: width: 600 }} 600w"
                sizes="(min-width: 990px) 18vw, (min-width: 750px) 30vw, 45vw"
                alt="{{ step_image.alt | default: step_title | escape }}"
                width="300"
                height="300"
                loading="lazy">
            {%- else -%}
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          <div class="ritual-card__body">
            {%- if block.settings.step_label != blank -%}
              <p class="ritual-card__step">
                {%- if section.settings.number_steps -%}{{ forloop.index }}. {% endif -%}
                {{ block.settings.step_label }}
              </p>
            {%- endif -%}

            {%- if step_title != blank -%}
              <h3 class="ritual-card__title">{{ step_title }}</h3>
            {%- endif -%}

            {%- if step_text != blank -%}
              <p class="ritual-card__text">{{ step_text }}</p>
            {%- endif -%}

            {%- if step_url != blank and step_link_label != blank -%}
              <a class="ritual-card__link" href="{{ step_url }}">
                {{ step_link_label }}
                {% render 'icon', icon: 'arrow-right', size: 16 %}
                <span class="visually-hidden">— {{ step_title | escape }}</span>
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Routine en étapes",
  "class": "section-ritual",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "VOTRE ROUTINE, DU BOL À LA GAMELLE" },
    { "type": "text", "id": "subheading", "label": "Sous-titre", "default": "4 essentiels pour un animal hydraté, propre et bien nourri" },
    { "type": "text", "id": "link_label", "label": "Libellé du lien des cartes", "default": "VOIR PLUS" },
    { "type": "checkbox", "id": "number_steps", "label": "Numéroter les étapes", "default": true },
    { "type": "select", "id": "color_scheme", "label": "Palette", "options": [
      { "value": "default", "label": "Par défaut" }, { "value": "surface", "label": "Blanc" },
      { "value": "soft", "label": "Vert clair" }, { "value": "band", "label": "Gris clair" }, { "value": "accent", "label": "Vert foncé" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Marge haute", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Marge basse", "default": 88 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit", "info": "L'image et le lien viennent du produit si les champs ci-dessous restent vides." },
        { "type": "text", "id": "step_label", "label": "Étape", "default": "HYDRATER" },
        { "type": "image_picker", "id": "image", "label": "Image (remplace celle du produit)" },
        { "type": "text", "id": "title", "label": "Titre (remplace celui du produit)" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "text", "id": "link_label", "label": "Libellé du lien" },
        { "type": "url", "id": "link", "label": "Lien (remplace la fiche produit)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine en étapes",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
