{%- comment -%}
  Rappel des packs en page d'accueil. Les prix sont lus sur le produit lui-même
  — pas de tarif saisi à la main qui se désynchroniserait du catalogue.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product

  assign pack_index = -1
  for opt in product.options_with_values
    assign n = opt.name | downcase
    if n contains 'pack' or n contains 'lot'
      assign pack_index = forloop.index0
    endif
  endfor

  assign base_unit_price = 0
  if pack_index >= 0
    for v in product.variants
      assign u = v.options[pack_index] | split: ' ' | first | plus: 0
      if u == 1
        assign base_unit_price = v.price
        break
      endif
    endfor
  endif
-%}
<div class="sw sw-block{% if section.settings.band %} sw-block--band{% endif %}">
  <div class="sw__wrap">
    <div class="sw__section-head sw__section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sw__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="sw__h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="sw__lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if pack_index >= 0 -%}
      <div class="sw-offer__grid">
        {%- assign pack_option = product.options_with_values[pack_index] -%}
        {%- for value in pack_option.values -%}
          {%- liquid
            assign units = value | split: ' ' | first | plus: 0
            if units < 1
              assign units = 1
            endif

            assign card_variant = nil
            for v in product.variants
              if v.options[pack_index] == value
                assign card_variant = v
                break
              endif
            endfor

            assign reference = base_unit_price | times: units
            assign saved = reference | minus: card_variant.price
            assign per_unit = card_variant.price | divided_by: units
            assign featured = false
            if units == 2
              assign featured = true
            endif
          -%}
          <div class="sw-offer__card{% if featured %} sw-offer__card--featured{% endif %}">
            {%- if featured and section.settings.ribbon != blank -%}
              <span class="sw-offer__ribbon">{{ section.settings.ribbon }}</span>
            {%- endif -%}

            <span class="sw-offer__qty">{{ value }}</span>
            <p class="sw-offer__price">{{ card_variant.price | money }}</p>
            {%- if saved > 0 -%}
              <span class="sw-offer__was">au lieu de <s>{{ reference | money }}</s></span>
            {%- endif -%}
            {%- if units > 1 -%}
              <span class="sw-offer__unit">{{ per_unit | money }} l'unité</span>
            {%- endif -%}

            <ul class="sw-offer__perks">
              {%- if units > 1 -%}
                <li>{% render 'sw-icon', icon: 'check' %}<span>Vous économisez {{ saved | money }}</span></li>
                <li>{% render 'sw-icon', icon: 'check' %}<span>Un propre pendant que l'autre est au lavage</span></li>
              {%- else -%}
                <li>{% render 'sw-icon', icon: 'check' %}<span>Pour essayer la coupe</span></li>
              {%- endif -%}
              {%- if units >= 3 -%}
                <li>{% render 'sw-icon', icon: 'check' %}<span>Une couleur pour chaque usage</span></li>
              {%- endif -%}
            </ul>

            <a href="{{ product.url }}?variant={{ card_variant.id }}" class="sw__btn {% if featured %}sw__btn--primary{% else %}sw__btn--ghost{% endif %} sw__btn--block">
              {{ section.settings.cta_label }}
            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="sw__lede" style="text-align:center;">
        Sélectionnez un produit à trois options (Pack / Couleur / Taille) dans les réglages de cette section.
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Packs Shapewear",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Offres" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un seul, ou de quoi tenir la semaine" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Un débardeur se porte à même la peau : il se lave après chaque journée. C'est la seule raison pour laquelle nos clients en prennent deux ou trois.</p>" },
    { "type": "text", "id": "ribbon", "label": "Ruban du pack mis en avant", "default": "Le plus choisi" },
    { "type": "text", "id": "cta_label", "label": "Libellé du bouton", "default": "Choisir ce pack" },
    { "type": "checkbox", "id": "band", "label": "Fond gris", "default": false }
  ],
  "presets": [{ "name": "Packs Shapewear" }]
}
{% endschema %}
