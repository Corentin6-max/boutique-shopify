<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width page-width--medium">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="compare" data-compare style="--compare-position: 50%;">
      {%- if section.settings.image_before != blank -%}
        <img class="compare__image" src="{{ section.settings.image_before | image_url: width: 1400 }}" alt="{{ section.settings.label_before | escape }}" width="{{ section.settings.image_before.width }}" height="{{ section.settings.image_before.height }}" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg compare__image' }}
      {%- endif -%}

      <div class="compare__after">
        {%- if section.settings.image_after != blank -%}
          <img src="{{ section.settings.image_after | image_url: width: 1400 }}" alt="{{ section.settings.label_after | escape }}" width="{{ section.settings.image_after.width }}" height="{{ section.settings.image_after.height }}" loading="lazy">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div
        class="compare__handle"
        role="slider"
        tabindex="0"
        aria-label="{{ section.settings.heading | escape }}"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"></div>

      <span class="compare__label compare__label--after">{{ section.settings.label_after }}</span>
      <span class="compare__label compare__label--before">{{ section.settings.label_before }}</span>
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="text-center text-muted" style="margin-top:2rem;font-size:1.35rem;">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Avant / after",
  "class": "section-before-after",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Avant / après" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "La différence en un mois" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image_after", "label": "Image après (révélée à gauche)" },
    { "type": "image_picker", "id": "image_before", "label": "Image avant" },
    { "type": "text", "id": "label_after", "label": "Libellé après", "default": "Après" },
    { "type": "text", "id": "label_before", "label": "Libellé avant", "default": "Avant" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Photos envoyées par une cliente, sans retouche." },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [
      { "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" },
      { "value": "soft", "label": "Soft accent" }, { "value": "band", "label": "Neutral band" }, { "value": "accent", "label": "Accent" }
    ], "default": "soft" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "presets": [{ "name": "Avant / after" }]
}
{% endschema %}
