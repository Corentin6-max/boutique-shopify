{%- comment -%}
  Tableau comparatif. Chaque ligne est un bloc : intitulé + trois états
  (nous / alternative 1 / alternative 2) valant « oui », « non » ou du texte.
{%- endcomment -%}
<div class="sw sw-block{% if section.settings.band %} sw-block--band{% endif %}">
  <div class="sw__wrap">
    <div class="sw__section-head{% if section.settings.centered %} sw__section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sw__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="sw__h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="sw__lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="sw-compare__scroll">
      <table class="sw-compare__table">
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col" class="sw-compare__col--us">{{ section.settings.col_us }}</th>
            <th scope="col">{{ section.settings.col_a }}</th>
            <th scope="col">{{ section.settings.col_b }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              {%- assign cells = block.settings.us | append: '||' | append: block.settings.a | append: '||' | append: block.settings.b | split: '||' -%}
              {%- for cell in cells -%}
                {%- assign value = cell | strip -%}
                <td {% if forloop.first %}class="sw-compare__col--us"{% endif %}>
                  {%- if value == 'oui' -%}
                    <span class="sw-mark sw-mark--yes">{% render 'sw-icon', icon: 'check' %}</span>
                    <span class="visually-hidden">Oui</span>
                  {%- elsif value == 'non' -%}
                    <span class="sw-mark sw-mark--no">{% render 'sw-icon', icon: 'cross' %}</span>
                    <span class="visually-hidden">Non</span>
                  {%- else -%}
                    {{ value }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparatif Shapewear",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pourquoi pas un débardeur classique ?" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "centered", "label": "Titre centré", "default": true },
    { "type": "checkbox", "id": "band", "label": "Fond gris", "default": true },
    { "type": "text", "id": "col_us", "label": "Colonne 1", "default": "Velluno" },
    { "type": "text", "id": "col_a", "label": "Colonne 2", "default": "Débardeur classique" },
    { "type": "text", "id": "col_b", "label": "Colonne 3", "default": "Gaine premier prix" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "label", "label": "Critère", "default": "Critère" },
        { "type": "text", "id": "us", "label": "Colonne 1 (oui / non / texte)", "default": "oui" },
        { "type": "text", "id": "a", "label": "Colonne 2", "default": "non" },
        { "type": "text", "id": "b", "label": "Colonne 3", "default": "non" }
      ]
    }
  ],
  "presets": [{ "name": "Comparatif Shapewear" }]
}
{% endschema %}
