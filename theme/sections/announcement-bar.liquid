{%- if section.blocks.size > 0 -%}
  <div
    class="announcement-bar"
    data-announcement
    data-speed="{{ section.settings.rotate_speed }}"
    style="--announcement-bg: {{ section.settings.background }}; --announcement-text: {{ section.settings.text_color }};">
    <div class="announcement-bar__inner">
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="announcement-bar__nav" data-announcement-nav="-1" aria-label="{{ 'sections.announcements.previous_announcement' | t }}">
          {% render 'icon', icon: 'chevron-left', size: 16 %}
        </button>
      {%- endif -%}

      <div>
        {%- for block in section.blocks -%}
          <div class="announcement-bar__slide {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              {{ block.settings.text }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <button type="button" class="announcement-bar__nav" data-announcement-nav="1" aria-label="{{ 'sections.announcements.next_announcement' | t }}">
          {% render 'icon', icon: 'chevron-right', size: 16 %}
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-bar-section",
  "max_blocks": 5,
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#2f4c3a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "range", "id": "rotate_speed", "min": 3, "max": 12, "step": 1, "unit": "s", "label": "Rotation speed", "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Livraison offerte dès 49€" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Livraison offerte dès 49€" } },
        { "type": "announcement", "settings": { "text": "30 jours pour changer d'avis" } },
        { "type": "announcement", "settings": { "text": "Matériaux sans BPA, sans danger" } }
      ]
    }
  ]
}
{% endschema %}
