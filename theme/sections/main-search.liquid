{% paginate search.results by 16 %}
  <div class="page-width" style="padding-block: 5rem 8rem;">
    <div class="section-header">
      <h1>{{ 'general.search.search' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter__form" style="margin-top:2rem;">
        <div class="field">
          <label class="visually-hidden" for="SearchInput">{{ 'general.search.search' | t }}</label>
          <input class="field__input" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
        </div>
        <button type="submit" class="button">{{ 'general.search.search' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="text-center text-muted" style="margin-bottom:3rem;">
          {{ 'general.search.results_with_count' | t: count: search.results_count }}
        </p>
        <div class="product-grid" style="--columns: 4;">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <article class="card">
                <div class="card__content">
                  <span class="card__vendor">{{ item.object_type }}</span>
                  <h2 class="card__title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
                  <p class="text-muted" style="font-size:1.4rem;">{{ item.content | strip_html | truncatewords: 20 }}</p>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="text-center text-muted">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
{% endpaginate %}

{% schema %}
{ "name": "Search results", "class": "section-main-search" }
{% endschema %}
