<section class="section faq scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="faq__layout{% unless section.settings.show_help_card %} faq__layout--single{% endunless %}">
      {%- if section.settings.show_help_card -%}
        <aside class="faq__aside">
          <div class="help-card">
            {%- if section.settings.help_heading != blank -%}
              <h2 class="help-card__heading">{{ section.settings.help_heading }}</h2>
            {%- endif -%}
            {%- if section.settings.help_text != blank -%}
              <div class="help-card__text rte">{{ section.settings.help_text }}</div>
            {%- endif -%}
            {%- if section.settings.help_button_label != blank -%}
              <a class="button" href="{{ section.settings.help_button_link | default: routes.root_url }}">
                {{ section.settings.help_button_label }}
              </a>
            {%- endif -%}
            {%- if section.settings.help_note != blank -%}
              <p class="help-card__note">{{ section.settings.help_note }}</p>
            {%- endif -%}
          </div>
        </aside>
      {%- endif -%}

      <div class="faq__main">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="faq__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte faq__intro">{{ section.settings.text }}</div>
        {%- endif -%}

        <div class="accordion">
          {%- for block in section.blocks -%}
            <details class="accordion__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                {{ block.settings.question }}
                <span class="accordion__icon">{% render 'icon', icon: 'plus', size: 20 %}</span>
              </summary>
              <div class="accordion__content rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>

        {%- if section.settings.footer_text != blank -%}
          <p class="text-muted faq__footer">{{ section.settings.footer_text }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.enable_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Questions fréquentes" },
    { "type": "richtext", "id": "text", "label": "Texte d'introduction" },
    { "type": "text", "id": "footer_text", "label": "Texte de bas de section" },
    { "type": "checkbox", "id": "open_first", "label": "Ouvrir la première question", "default": true },
    { "type": "checkbox", "id": "enable_schema", "label": "Ajouter les données structurées FAQ", "default": true },

    { "type": "header", "content": "Encadré d'aide" },
    { "type": "checkbox", "id": "show_help_card", "label": "Afficher l'encadré « Besoin d'aide ? »", "default": true },
    { "type": "text", "id": "help_heading", "label": "Titre de l'encadré", "default": "Besoin d'aide ?" },
    { "type": "richtext", "id": "help_text", "label": "Texte", "default": "<p>Une question sur une taille, une commande ou un produit ? Écrivez-nous, une vraie personne vous répond sous 24 h ouvrées.</p>" },
    { "type": "text", "id": "help_button_label", "label": "Bouton", "default": "Nous contacter" },
    { "type": "url", "id": "help_button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "help_note", "label": "Note sous le bouton", "default": "bonjour@velluno.fr · du lundi au vendredi, 9h–18h" },

    { "type": "header", "content": "Style" },
    { "type": "select", "id": "color_scheme", "label": "Palette", "options": [
      { "value": "default", "label": "Par défaut" }, { "value": "surface", "label": "Blanc" },
      { "value": "soft", "label": "Vert clair" }, { "value": "band", "label": "Gris clair" }, { "value": "accent", "label": "Vert foncé" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Marge haute", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Marge basse", "default": 88 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Quels sont les délais de livraison ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Nous expédions sous 24 h ouvrées. Comptez 2 à 5 jours ouvrés pour la France métropolitaine.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Quels sont les délais de livraison ?", "answer": "<p>Nous expédions sous 24 h ouvrées. Comptez 2 à 5 jours ouvrés pour la France métropolitaine.</p>" } },
        { "type": "question", "settings": { "question": "La livraison est-elle offerte ?", "answer": "<p>Oui, dès 49€ d'achat. En dessous, la livraison suivie est à 4,90€.</p>" } },
        { "type": "question", "settings": { "question": "Puis-je retourner un produit ?", "answer": "<p>Vous avez 30 jours après réception, même si le produit a servi.</p>" } },
        { "type": "question", "settings": { "question": "Les matériaux sont-ils sans danger ?", "answer": "<p>Silicone alimentaire, acier inoxydable 304 et caoutchouc non toxique, sans BPA.</p>" } }
      ]
    }
  ]
}
{% endschema %}
