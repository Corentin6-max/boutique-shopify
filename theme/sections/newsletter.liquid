<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width page-width--narrow text-center">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte" style="margin-bottom:2.8rem;">{{ section.settings.text }}</div>{%- endif -%}

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="field">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
        <input
          class="field__input"
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ 'general.newsletter_form.email_placeholder' | t }}"
          autocomplete="email"
          required>
      </div>
      {%- liquid
        assign submit_label = section.settings.button_label
        if submit_label == blank
          assign submit_label = 'general.newsletter_form.button_label' | t
        endif
      -%}
      <button type="submit" class="button">{{ submit_label }}</button>
    {%- endform -%}

    {%- if section.settings.disclaimer != blank -%}
      <p class="text-muted" style="font-size:1.25rem;margin-top:1.6rem;">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rejoignez la newsletter" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>10% sur votre première commande et les nouveautés en avant-première.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Je m'inscris" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Un ou deux e-mails par mois. Désinscription en un clic." },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [
      { "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" },
      { "value": "soft", "label": "Soft accent" }, { "value": "accent", "label": "Accent" }
    ], "default": "soft" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
