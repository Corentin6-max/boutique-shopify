<article class="page-width page-width--narrow" style="padding-block: 5rem 8rem;">
  <header class="text-center" style="margin-bottom:4rem;">
    <p class="eyebrow">{{ article.published_at | date: format: 'date' }}</p>
    <h1>{{ article.title }}</h1>
    {%- if section.settings.show_author and article.author != blank -%}
      <p class="text-muted">{{ 'sections.blog.by_author' | t: author: article.author }}</p>
    {%- endif -%}
  </header>

  {%- if article.image and section.settings.show_image -%}
    <div class="media media--wide" style="margin-bottom:4rem;">
      <img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.image.alt | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}" fetchpriority="high">
    </div>
  {%- endif -%}

  <div class="rte">{{ article.content }}</div>

  {%- if section.settings.show_share -%}
    <div style="margin-top:4rem;">
      {% render 'share-button', share_url: article.url, share_title: article.title %}
    </div>
  {%- endif -%}

  <p style="margin-top:4rem;"><a class="link" href="{{ blog.url }}">{{ 'sections.blog.back_to_blog' | t }}</a></p>

  {%- if blog.comments_enabled? -%}
    <section style="margin-top:6rem;">
      <h2 class="h3">{{ article.comments_count }} comments</h2>

      {%- for comment in article.comments -%}
        <div class="testimonial" style="margin-bottom:1.6rem;">
          <p class="testimonial__quote">{{ comment.content }}</p>
          <span class="testimonial__name">{{ comment.author }}</span>
        </div>
      {%- endfor -%}

      {%- form 'new_comment', article -%}
        {%- if form.errors -%}
          <p class="form__message">{{ form.errors.messages.form }}</p>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success">Thanks — your comment is awaiting moderation.</p>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="CommentAuthor">{{ 'sections.contact.name' | t }}</label>
          <input class="field__input" id="CommentAuthor" name="comment[author]" type="text" required>
        </div>
        <div class="field">
          <label class="field__label" for="CommentEmail">{{ 'sections.contact.email' | t }}</label>
          <input class="field__input" id="CommentEmail" name="comment[email]" type="email" required>
        </div>
        <div class="field">
          <label class="field__label" for="CommentBody">{{ 'sections.contact.message' | t }}</label>
          <textarea id="CommentBody" name="comment[body]" required></textarea>
        </div>
        <button type="submit" class="button">{{ 'sections.contact.send' | t }}</button>
      {%- endform -%}
    </section>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} }
  }
</script>

{% schema %}
{
  "name": "Article",
  "class": "section-main-article",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "Show featured image", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show share buttons", "default": true }
  ]
}
{% endschema %}
