{%- liquid
  assign product_variant = product.selected_or_first_available_variant
-%}
<section class="scheme-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="product" data-product-gallery>
      {%- comment -%} ---------------------------------------------- Media {%- endcomment -%}
      <div class="product__media-wrapper">
        <div class="product__media-main media">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div class="product__media-item {% if forloop.first %}is-active{% endif %}" data-media-item="{{ media.id }}">
                {%- if media.media_type == 'image' -%}
                  <img
                    src="{{ media | image_url: width: 1200 }}"
                    srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1400 }} 1400w"
                    sizes="(min-width: 990px) 55vw, 100vw"
                    alt="{{ media.alt | escape }}"
                    width="{{ media.width }}"
                    height="{{ media.height }}"
                    {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
                {%- else -%}
                  {{ media | media_tag: image_size: '1200x', autoplay: false, loop: false, controls: true }}
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product__thumbs">
            {%- for media in product.media -%}
              <button
                type="button"
                class="product__thumb {% if forloop.first %}is-active{% endif %}"
                data-media-id="{{ media.id }}"
                aria-label="{{ 'products.product.media_gallery' | t }} {{ forloop.index }}">
                <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" width="80" height="80" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ------------------------------------------ Buy box {%- endcomment -%}
      <div class="product__info" data-sticky-trigger>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              <p class="card__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>

            {%- when 'title' -%}
              <h1 class="product__title h1" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'rating' -%}
              <div class="product__meta" {{ block.shopify_attributes }}>
                {% render 'rating', product: product, show_count: true, fallback_rating: block.settings.fallback_rating, fallback_count: block.settings.fallback_count %}
                {%- if block.settings.text != blank -%}
                  <span class="text-muted" style="font-size:1.35rem;">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>

            {%- when 'price' -%}
              <div class="product__price" data-price-target {{ block.shopify_attributes }}>
                {% render 'price', product: product, use_variant: true, show_badges: true %}
              </div>
              {%- if block.settings.show_tax_note -%}
                <p class="text-muted" style="font-size:1.3rem;margin-top:-1.2rem;">
                  {{ 'products.product.include_taxes' | t }}
                  {%- if shop.shipping_policy.body != blank %}
                    {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- endif %}
                </p>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="rte" style="margin-bottom:2rem;" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'icon_list' -%}
              <ul class="stack" style="margin-bottom:2.4rem;" {{ block.shopify_attributes }}>
                {%- assign lines = block.settings.items | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- if line != blank -%}
                    <li style="display:flex;gap:1rem;align-items:flex-start;font-size:1.5rem;">
                      <span style="color:var(--color-accent);flex:0 0 auto;">{% render 'icon', icon: block.settings.icon, size: 20 %}</span>
                      <span>{{ line | strip }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'bundles' -%}
              <div class="bundle-options" data-bundle-group {{ block.shopify_attributes }}>
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign qty_key = 'quantity_' | append: i
                    assign title_key = 'title_' | append: i
                    assign subtitle_key = 'subtitle_' | append: i
                    assign tag_key = 'tag_' | append: i
                    assign qty = block.settings[qty_key]
                    assign line_title = block.settings[title_key]
                  -%}
                  {%- if qty > 0 and line_title != blank -%}
                    <div
                      class="bundle-option {% if block.settings.default_option == i %}is-selected{% endif %}"
                      data-bundle-option
                      data-bundle-quantity="{{ qty }}"
                      role="button"
                      tabindex="0">
                      <span class="bundle-option__radio" aria-hidden="true"></span>
                      <span>
                        <span class="bundle-option__title">{{ line_title }}</span>
                        {%- if block.settings[subtitle_key] != blank -%}
                          <span class="bundle-option__subtitle" style="display:block;">{{ block.settings[subtitle_key] }}</span>
                        {%- endif -%}
                      </span>
                      <span class="price">
                        <span class="price__regular">{{ product_variant.price | times: qty | money }}</span>
                      </span>
                      {%- if block.settings[tag_key] != blank -%}
                        <span class="bundle-option__tag">{{ block.settings[tag_key] }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
                <input type="hidden" data-bundle-input name="bundle_quantity" form="ProductForm-{{ section.id }}" value="{{ block.settings.default_quantity }}">
              </div>

            {%- when 'variant_picker' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'product-form',
                  product: product,
                  section_id: section.id,
                  show_quantity: block.settings.show_quantity,
                  show_dynamic_checkout: block.settings.show_dynamic_checkout,
                  button_label: block.settings.button_label %}
              </div>

            {%- when 'inventory' -%}
              {%- if product_variant.available and product_variant.inventory_management != blank and product_variant.inventory_quantity > 0 and product_variant.inventory_quantity <= block.settings.threshold -%}
                <p class="badge badge--sale" style="margin-bottom:2rem;" {{ block.shopify_attributes }}>
                  {{ 'products.product.inventory_low' | t: count: product_variant.inventory_quantity }}
                </p>
              {%- elsif product_variant.available -%}
                <p class="text-muted" style="font-size:1.35rem;margin-bottom:2rem;" {{ block.shopify_attributes }}>
                  {{ 'products.product.in_stock' | t }}
                </p>
              {%- endif -%}

            {%- when 'description' -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>

            {%- when 'accordion' -%}
              <details class="accordion__item" {{ block.shopify_attributes }}>
                <summary class="accordion__summary">
                  {{ block.settings.heading }}
                  <span class="accordion__icon">{% render 'icon', icon: 'plus', size: 20 %}</span>
                </summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ pages[block.settings.page].content }}{%- endif -%}
                </div>
              </details>

            {%- when 'share' -%}
              <div style="margin-top:2rem;" {{ block.shopify_attributes }}>
                {% render 'share-button', share_url: product.url, share_title: product.title %}
              </div>

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

            {%- when '@app' -%}
              <div {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.enable_sticky_atc -%}
  <div class="sticky-atc" data-sticky-atc>
    <div class="sticky-atc__info">
      <div class="sticky-atc__title">{{ product.title }}</div>
      {% render 'price', product: product, use_variant: true %}
    </div>
    <button
      type="submit"
      class="button"
      form="ProductForm-{{ section.id }}"
      {% unless product_variant.available %}aria-disabled="true"{% endunless %}>
      {%- if product_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
    </button>
  </div>
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    "description": {{ product.description | strip_html | truncate: 500 | json }},
    {% if product.featured_media -%}
      "image": {{ product.featured_media | image_url: width: 1200 | prepend: "https:" | json }},
    {%- endif %}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "sku": {{ variant.sku | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "enable_sticky_atc", "label": "Sticky add to cart on mobile", "default": true },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [
      { "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" },
      { "value": "soft", "label": "Soft accent" }
    ], "default": "default" }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "rating", "name": "Rating", "limit": 1, "settings": [
      { "type": "number", "id": "fallback_rating", "label": "Fallback rating (no reviews app)", "default": 5 },
      { "type": "number", "id": "fallback_count", "label": "Fallback review count", "default": 0 },
      { "type": "text", "id": "text", "label": "Text beside stars", "default": "Avis vérifiés" }
    ] },
    { "type": "price", "name": "Price", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_tax_note", "label": "Show tax and shipping note", "default": true }
    ] },
    { "type": "text", "name": "Short text", "settings": [
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Livraison offerte dès 49€ · Expédié sous 24 h · 30 jours pour changer d'avis.</p>" }
    ] },
    { "type": "icon_list", "name": "Benefit list", "settings": [
      { "type": "textarea", "id": "items", "label": "One item per line", "default": "Matériaux sans BPA, contrôlés en laboratoire\nExpédition sous 24 h ouvrées\nRetour gratuit sous 30 jours" },
      { "type": "select", "id": "icon", "label": "Icon", "options": [
        { "value": "sparkle", "label": "Sparkle" }, { "value": "leaf", "label": "Leaf" },
        { "value": "drop", "label": "Drop" }, { "value": "shield", "label": "Shield" }
      ], "default": "sparkle" }
    ] },
    { "type": "bundles", "name": "Quantity offers", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Shows quantity tiers that set the add-to-cart quantity. Pair with a Shopify volume discount for the price break." },
      { "type": "range", "id": "default_option", "min": 1, "max": 3, "step": 1, "label": "Selected by default", "default": 2 },
      { "type": "number", "id": "default_quantity", "label": "Default quantity", "default": 2 },
      { "type": "header", "content": "Option 1" },
      { "type": "number", "id": "quantity_1", "label": "Quantity", "default": 1 },
      { "type": "text", "id": "title_1", "label": "Title", "default": "1 exemplaire" },
      { "type": "text", "id": "subtitle_1", "label": "Subtitle", "default": "Pour essayer" },
      { "type": "text", "id": "tag_1", "label": "Tag" },
      { "type": "header", "content": "Option 2" },
      { "type": "number", "id": "quantity_2", "label": "Quantity", "default": 2 },
      { "type": "text", "id": "title_2", "label": "Title", "default": "2 exemplaires" },
      { "type": "text", "id": "subtitle_2", "label": "Subtitle", "default": "Le choix le plus fréquent" },
      { "type": "text", "id": "tag_2", "label": "Tag", "default": "Le plus choisi" },
      { "type": "header", "content": "Option 3" },
      { "type": "number", "id": "quantity_3", "label": "Quantity", "default": 3 },
      { "type": "text", "id": "title_3", "label": "Title", "default": "3 exemplaires" },
      { "type": "text", "id": "subtitle_3", "label": "Subtitle", "default": "Meilleur prix à l'unité" },
      { "type": "text", "id": "tag_3", "label": "Tag", "default": "Meilleure offre" }
    ] },
    { "type": "variant_picker", "name": "Variants and add to cart", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": false },
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true },
      { "type": "text", "id": "button_label", "label": "Button label" }
    ] },
    { "type": "inventory", "name": "Inventory status", "limit": 1, "settings": [
      { "type": "number", "id": "threshold", "label": "Low stock threshold", "default": 10 }
    ] },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "accordion", "name": "Accordion row", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Comment ça marche" },
      { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Rinçage à l'eau tiède savonneuse. Silicone et acier inoxydable au lave-vaisselle.</p>" },
      { "type": "page", "id": "page", "label": "Content from page" }
    ] },
    { "type": "share", "name": "Share", "limit": 1 },
    { "type": "custom_liquid", "name": "Custom Liquid", "settings": [
      { "type": "liquid", "id": "custom_liquid", "label": "Liquid" }
    ] },
    { "type": "@app" }
  ]
}
{% endschema %}
