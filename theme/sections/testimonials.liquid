<section class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p>
          <span class="rating">
            <span class="rating__stars" aria-hidden="true">★★★★★</span>
            <span>{{ section.settings.subheading }}</span>
          </span>
        </p>
      {%- endif -%}
    </div>

    <div class="{% if section.settings.layout == 'scroll' %}scroller{% else %}grid grid--{{ section.settings.columns }}{% endif %}">
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          <span class="rating__stars" aria-hidden="true">
            {%- for i in (1..5) -%}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
          </span>
          {%- if block.settings.title != blank -%}
            <h3 class="h4" style="margin:0;">{{ block.settings.title }}</h3>
          {%- endif -%}
          <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
          <figcaption class="testimonial__author">
            {%- if block.settings.avatar != blank -%}
              <img class="testimonial__avatar" src="{{ block.settings.avatar | image_url: width: 120 }}" alt="{{ block.settings.name | escape }}" width="44" height="44" loading="lazy">
            {%- endif -%}
            <span>
              <span class="testimonial__name">{{ block.settings.name }}</span>
              {%- if block.settings.role != blank -%}
                <span class="testimonial__role" style="display:block;">{{ block.settings.role }}</span>
              {%- endif -%}
            </span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "class": "section-testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Avis" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ce que disent nos clients" },
    { "type": "text", "id": "subheading", "label": "Rating line", "default": "4,8 de moyenne sur les avis vérifiés" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "grid", "label": "Grid" }, { "value": "scroll", "label": "Horizontal scroll" }
    ], "default": "grid" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [
      { "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" },
      { "value": "soft", "label": "Soft accent" }, { "value": "accent", "label": "Accent" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Stars", "default": 5 },
        { "type": "text", "id": "title", "label": "Short headline", "default": "Ma chatte boit enfin assez" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "La fontaine tourne depuis deux mois, aucun bruit la nuit et l'eau reste claire. Le filtre se change en dix secondes." },
        { "type": "image_picker", "id": "avatar", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name", "default": "Camille R." },
        { "type": "text", "id": "role", "label": "Detail", "default": "Client vérifié" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
