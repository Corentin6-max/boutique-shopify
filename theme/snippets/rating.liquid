{%- comment -%}
  Renders a star rating from the product reviews metafield, or a static
  fallback so the design reads correctly before a reviews app is installed.
  Accepts: product (object), fallback_rating (number), fallback_count (number), show_count (bool)
{%- endcomment -%}
{%- liquid
  assign rating_value = fallback_rating | default: 4.9
  assign rating_count = fallback_count | default: 0
  if product.metafields.reviews.rating.value != blank
    assign rating_value = product.metafields.reviews.rating.value.rating
    assign rating_count = product.metafields.reviews.rating_count.value
  endif
  assign rounded = rating_value | round
-%}
<span class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: 5 }}">
  <span class="rating__stars" aria-hidden="true">
    {%- for i in (1..5) -%}{% if i <= rounded %}★{% else %}☆{% endif %}{%- endfor -%}
  </span>
  {%- if show_count and rating_count > 0 -%}
    <span class="rating__count">({{ rating_count }})</span>
  {%- endif -%}
</span>
