{%- comment -%} Accepts: product (object), section_id (string) {%- endcomment -%}
{%- unless product.has_only_default_variant -%}
  {%- for option in product.options_with_values -%}
    <fieldset class="variant-picker" role="radiogroup">
      <legend class="variant-picker__legend">
        {{ option.name }}:
        <span class="text-muted" data-option-value>{{ option.selected_value }}</span>
      </legend>
      <div class="variant-picker__options">
        {%- for value in option.values -%}
          {%- assign input_id = section_id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}
          <input
            type="radio"
            id="{{ input_id }}"
            name="{{ option.name }}-{{ option.position }}-{{ section_id }}"
            value="{{ value | escape }}"
            {% if option.selected_value == value %}checked{% endif %}>
          <label for="{{ input_id }}">{{ value }}</label>
        {%- endfor -%}
      </div>
    </fieldset>
  {%- endfor -%}
{%- endunless -%}

<script type="application/json" data-variant-json>
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "options": {{ variant.options | json }},
        "price": {{ variant.price }},
        "compare_at_price": {{ variant.compare_at_price | default: 0 }},
        "available": {{ variant.available }},
        "featured_media_id": {{ variant.featured_media.id | default: 0 }},
        "title": {{ variant.title | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>
