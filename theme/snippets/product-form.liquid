{%- comment -%}
  Renders the add-to-cart form.
  Accepts: product (object), section_id (string), show_quantity (bool),
           show_dynamic_checkout (bool), button_label (string)
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign add_label = button_label
  if add_label == blank
    assign add_label = 'products.product.add_to_cart' | t
  endif
  assign product_form_id = 'ProductForm-' | append: section_id
  assign quantity_id = 'Quantity-' | append: section_id
-%}
<div
  data-variant-picker
  data-product-handle="{{ product.handle }}"
  data-add-text="{{ add_label | escape }}"
  data-sold-out-text="{{ 'products.product.sold_out' | t | escape }}"
  data-unavailable-text="{{ 'products.product.unavailable' | t | escape }}">

  {% render 'product-variant-picker', product: product, section_id: section_id %}

  {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-product-form: 'true' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

    <div class="product-form__buttons">
      <div class="product-form__quantity-row">
        {%- if show_quantity -%}
          {% render 'quantity-input', id: quantity_id, value: 1, min: 1 %}
        {%- else -%}
          <input type="hidden" name="quantity" value="1">
        {%- endif -%}

        <button
          type="submit"
          name="add"
          class="button button--large"
          data-add-button
          {% unless current_variant.available %}aria-disabled="true"{% endunless %}>
          <span class="loading-spinner"></span>
          <span data-add-button-text>
            {%- if current_variant.available -%}{{ add_label }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </span>
        </button>
      </div>

      {%- if show_dynamic_checkout -%}
        {{ form | payment_button }}
      {%- endif -%}

      <p class="form__message" data-form-error role="alert"></p>
    </div>
  {%- endform -%}
</div>
