{%- comment -%} Free shipping progress bar based on the cart total. {%- endcomment -%}
{%- if settings.cart_free_shipping_bar and settings.cart_free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.cart_free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign percent = cart.total_price | times: 100 | divided_by: threshold
    if percent > 100
      assign percent = 100
    endif
  -%}
  <div class="shipping-bar">
    <p class="shipping-bar__text">
      {%- if remaining > 0 -%}
        {{ 'sections.cart.free_shipping_progress_html' | t: amount: remaining | money }}
      {%- else -%}
        {{ 'sections.cart.free_shipping_unlocked' | t }}
      {%- endif -%}
    </p>
    <div class="shipping-bar__track">
      <div class="shipping-bar__fill" style="width: {{ percent }}%;"></div>
    </div>
  </div>
{%- endif -%}
