{%- comment -%} Accepts: share_url (string), share_title (string) {%- endcomment -%}
{%- assign url = shop.url | append: share_url -%}
<div class="share">
  <span class="text-muted" style="font-size:1.35rem;margin-right:1rem;">{{ 'general.share.share' | t }}</span>
  {%- if settings.share_facebook -%}
    <a class="header__icon" href="https://www.facebook.com/sharer.php?u={{ url }}" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">
      {% render 'icon', icon: 'facebook', size: 18 %}
    </a>
  {%- endif -%}
  {%- if settings.share_pinterest -%}
    <a class="header__icon" href="https://pinterest.com/pin/create/button/?url={{ url }}&description={{ share_title | escape }}" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">
      {% render 'icon', icon: 'pinterest', size: 18 %}
    </a>
  {%- endif -%}
  {%- if settings.share_twitter -%}
    <a class="header__icon" href="https://x.com/intent/post?text={{ share_title | escape }}&url={{ url }}" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7 8 8.3 12H17l-5-7.2L6.2 22H3l7.5-8.6L2.5 2h6.6l4.6 6.6L18.9 2Zm-1.1 18h1.7L7.3 3.8H5.5L17.8 20Z"/></svg>
    </a>
  {%- endif -%}
</div>
