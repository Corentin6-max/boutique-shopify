<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bone }}">
    <title>{{ shop.name }}{% if page_title %} &ndash; {{ page_title }}{% endif %}</title>
    <meta name="description" content="{{ shop.description | default: settings.brand_tagline | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <script>document.documentElement.className = document.documentElement.className.replace('no-js','js');</script>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
    {%- endif -%}
    <style>
      :root{
        --velluno-ink:{{ settings.color_ink }};--velluno-bone:{{ settings.color_bone }};
        --velluno-sand:{{ settings.color_sand }};--velluno-sage:{{ settings.color_sage }};
        --velluno-clay:{{ settings.color_clay }};--velluno-steel:{{ settings.color_steel }};
        --velluno-success:{{ settings.color_success }};--velluno-error:{{ settings.color_error }};
        --font-heading:{{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-body:{{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      }
      body{margin:0;background:var(--velluno-bone)}
    </style>
    <link rel="stylesheet" href="{{ 'velluno.css' | asset_url }}">
    <script type="module" src="{{ 'velluno.js' | asset_url }}"></script>
    {{ content_for_header }}
  </head>
  <body class="template-password">
    {% render 'icon-sprite' %}
    {{ content_for_layout }}
  </body>
</html>
