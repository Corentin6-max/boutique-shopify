<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bone }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- comment -%}
      Set the js class before first paint so scroll-reveal elements start
      hidden without flashing. Without JS the class never lands and every
      [data-reveal] block stays visible — graceful degradation by default.
    {%- endcomment -%}
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- else -%}
      {%- comment -%} Fallback favicon: the VELLUNO drop, inline, zero requests. {%- endcomment -%}
      <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231C1C1A'/%3E%3Cpath d='M16 7s6 6.6 6 10.5a6 6 0 0 1-12 0C10 13.6 16 7 16 7z' fill='none' stroke='%23FAF8F4' stroke-width='1.8' stroke-linejoin='round'/%3E%3C/svg%3E">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- comment -%}
      ------------------------------------------------------------------
      CRITICAL CSS — above-the-fold only, kept deliberately under 14 KB.
      Design tokens live here because everything downstream depends on
      them; the full stylesheet (assets/velluno.css) is the source of
      truth and is loaded non-blocking just below.
      ------------------------------------------------------------------
    {%- endcomment -%}
    {%- liquid
      assign heading_font = settings.font_heading
      assign body_font = settings.font_body
      assign body_scale = settings.font_body_scale | default: 100 | divided_by: 100.0
      assign base_size = 16 | times: body_scale
    -%}
    <style>
      :root{
        --velluno-ink:{{ settings.color_ink }};--velluno-bone:{{ settings.color_bone }};
        --velluno-sand:{{ settings.color_sand }};--velluno-sage:{{ settings.color_sage }};
        --velluno-clay:{{ settings.color_clay }};--velluno-steel:{{ settings.color_steel }};
        --velluno-success:{{ settings.color_success }};--velluno-error:{{ settings.color_error }};
        --font-heading:{{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-body:{{ body_font.family }}, {{ body_font.fallback_families }};
        --font-heading-weight:{{ settings.font_heading_weight | default: 500 }};
        --font-body-weight:{{ body_font.weight }};
        --sp-2:8px;--sp-3:12px;--sp-4:16px;--sp-5:24px;--sp-6:32px;
        --gutter:clamp(16px,4vw,48px);--page-max:1360px;--header-h:68px;
        --radius-button:2px;--radius-card:12px;
        --ease:cubic-bezier(.22,.61,.36,1);--dur:200ms;
      }
      @media(min-width:1024px){:root{--header-h:84px}}
      *,*::before,*::after{box-sizing:border-box}
      body{margin:0;background:var(--velluno-bone);color:var(--velluno-ink);
        font-family:var(--font-body);font-size:{{ base_size | round: 1 }}px;line-height:1.65;
        -webkit-font-smoothing:antialiased}
      img,svg{display:block;max-width:100%}img{height:auto}
      h1,h2,h3{font-family:var(--font-heading);font-weight:var(--font-heading-weight);
        line-height:1.12;letter-spacing:-.015em;margin:0}
      a{color:inherit}button{font:inherit;background:none;border:0;padding:0;cursor:pointer}
      .container{width:100%;max-width:var(--page-max);margin-inline:auto;padding-inline:var(--gutter)}
      .header{position:sticky;top:0;z-index:60;background:var(--velluno-bone);border-bottom:1px solid transparent}
      .header__inner{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;
        gap:var(--sp-4);min-height:var(--header-h)}
      .header__logo{justify-self:center;display:inline-flex}
      .header__nav{display:none}
      .header__actions{display:flex;align-items:center;justify-content:flex-end}
      .header__left{display:flex;align-items:center}
      @media(min-width:1024px){.header__nav{display:flex;align-items:center;gap:var(--sp-5)}
        .header__burger{display:none}}
      .icon-btn{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;
        border-radius:999px;position:relative}
      .icon-btn svg{width:21px;height:21px}
      .announcement{background:var(--velluno-ink);color:var(--velluno-bone);font-size:.8125rem;text-align:center}
      .announcement__viewport{overflow:hidden;position:relative}
      .announcement__track{display:flex}
      .announcement__item{flex:0 0 100%;padding:var(--sp-3) var(--sp-4);display:flex;align-items:center;
        justify-content:center;gap:var(--sp-2);opacity:0}
      .announcement__item.is-active{opacity:1}
      .hero{position:relative;background:var(--velluno-sand);overflow:hidden}
      .hero__grid{display:grid;align-items:center;gap:var(--sp-6)}
      .hero__content{padding-block:64px;max-width:34rem}
      .hero__title{font-size:clamp(2.25rem,4.4vw + 1.2rem,4rem)}
      @media(min-width:900px){.hero__grid{grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);
        gap:96px;min-height:min(78vh,720px)}}
      .btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--sp-2);min-height:50px;
        padding:var(--sp-3) var(--sp-6);background:var(--velluno-ink);color:var(--velluno-bone);
        border:1px solid var(--velluno-ink);border-radius:var(--radius-button);font-size:.9375rem;
        font-weight:600;letter-spacing:.04em;text-transform:uppercase;text-decoration:none}
      .visually-hidden{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;
        overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}
      [hidden]{display:none!important}
      .js [data-reveal]{opacity:0;transform:translateY(14px)}
    </style>

    {%- comment -%} Full stylesheet: non-blocking, with a no-JS fallback. {%- endcomment -%}
    <link rel="preload" href="{{ 'velluno.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'velluno.css' | asset_url }}"></noscript>
    <script>
      // Browsers without rel=preload support still need the stylesheet.
      (function () {
        var link = document.querySelector('link[rel="preload"][as="style"]');
        if (link && !(link.relList && link.relList.supports && link.relList.supports('preload'))) {
          link.rel = 'stylesheet';
        }
      })();
    </script>

    <script type="module" src="{{ 'velluno.js' | asset_url }}"></script>
    <script type="module" src="{{ 'cart-drawer.js' | asset_url }}"></script>
    <script type="module" src="{{ 'product-form.js' | asset_url }}"></script>

    {{ content_for_header }}

    {% render 'structured-data' %}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    {%- comment -%}
      The icon sprite is inlined once per page: Safari does not support
      external file references in <use>, so a CDN-hosted sprite would
      silently render nothing there.
    {%- endcomment -%}
    {% render 'icon-sprite' %}

    <a class="skip-link" href="#main">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {%- comment -%} Shared overlay for the nav drawer, search and cart drawer. {%- endcomment -%}
    <div class="overlay" data-overlay></div>

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if settings.show_cookie_banner -%}
      <aside class="cookie" data-cookie-banner role="dialog" aria-live="polite"
             aria-labelledby="cookie-title" hidden>
        <h2 class="cookie__title" id="cookie-title">{{ 'cookies.title' | t }}</h2>
        <p class="cookie__text">
          {{ 'cookies.text' | t }}
          {%- if settings.cookie_policy_url != blank %}
            <a class="link" href="{{ settings.cookie_policy_url }}">{{ 'cookies.learn_more' | t }}</a>
          {%- endif %}
        </p>
        {%- comment -%}
          Refusing is exactly as easy as accepting: same size, same position,
          same visual weight. Required by the CNIL.
        {%- endcomment -%}
        <div class="cookie__actions">
          <button type="button" class="btn btn--secondary btn--sm" data-cookie-decline>{{ 'cookies.decline' | t }}</button>
          <button type="button" class="btn btn--primary btn--sm" data-cookie-accept>{{ 'cookies.accept' | t }}</button>
        </div>
      </aside>
    {%- endif -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'general.accessibility.loading' | t }}</li>
    </ul>
  </body>
</html>
