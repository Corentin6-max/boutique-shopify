{%- comment -%}
  Password page. Designed, not default: brand panel on the left, a botanical
  still-life placeholder on the right. Two jobs only — capture an email for
  launch, and let the owner in.
{%- endcomment -%}
<div class="password">
  <div class="password__panel">
    <div class="password__logo">
      {% render 'velluno-logo', variant: settings.logo_variant %}
    </div>

    <p class="eyebrow">{{ settings.brand_tagline | default: "L'essentiel, pensé pour eux." }}</p>
    <h1 class="h2">{{ 'password_page.title' | t }}</h1>
    <p class="lede mt-4">{{ 'password_page.text' | t }}</p>

    <div class="password__form">
      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
        <label class="visually-hidden" for="password-email">{{ 'general.newsletter.email_label' | t }}</label>
        <input
          id="password-email"
          class="input"
          type="email"
          name="contact[email]"
          autocomplete="email"
          required
          placeholder="{{ 'general.newsletter.email_placeholder' | t }}">
        <button type="submit" class="btn btn--primary">{{ 'general.newsletter.submit' | t }}</button>

        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success mt-4" role="status">
            {% render 'icon', name: 'check-circle' %} {{ 'general.newsletter.success' | t }}
          </p>
        {%- elsif form.errors -%}
          <p class="form-status form-status--error mt-4" role="alert">
            {% render 'icon', name: 'alert' %} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endform -%}
      <p class="caption mt-4">{{ 'general.newsletter.consent' | t }}</p>
    </div>

    <div class="password__foot">
      <details>
        <summary class="link">{{ 'password_page.password_label' | t }}</summary>
        <div class="mt-4">
          {%- form 'storefront_password', class: 'newsletter__form' -%}
            <label class="visually-hidden" for="store-password">{{ 'password_page.password_placeholder' | t }}</label>
            <input
              id="store-password"
              class="input"
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="{{ 'password_page.password_placeholder' | t }}">
            <button type="submit" class="btn btn--secondary">{{ 'password_page.enter' | t }}</button>
            {%- if form.errors -%}
              <p class="form-status form-status--error mt-4" role="alert">{{ 'password_page.error' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </details>
      <p class="mt-5">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>
  </div>

  <div class="password__aside">
    {%- if settings.share_image != blank -%}
      <img src="{{ settings.share_image | image_url: width: 1200 }}"
           alt="{{ settings.share_image.alt | default: shop.name | escape }}"
           width="1200" height="1200" loading="eager" decoding="async">
    {%- else -%}
      <img src="{{ 'placeholder-password.svg' | asset_url }}" alt=""
           width="900" height="1200" loading="eager" decoding="async">
    {%- endif -%}
  </div>
</div>
