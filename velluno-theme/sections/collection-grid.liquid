{%- comment -%}
  Grid of collection cards — the univers-level entry point on the homepage.
{%- endcomment -%}
<section class="section" aria-labelledby="collections-{{ section.id }}">
  <div class="container">
    <div class="section__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="h2" id="collections-{{ section.id }}">{{ section.settings.title }}</h2>
    </div>

    <div class="grid grid--3" data-reveal-group>
      {%- for block in section.blocks -%}
        {%- assign target = collections[block.settings.collection] -%}
        <a class="collection-card" href="{{ target.url | default: block.settings.link }}"
           data-reveal {{ block.shopify_attributes }}>
          <span class="collection-card__bg">
            {%- assign card_image = block.settings.image | default: target.featured_image -%}
            {%- if card_image != blank -%}
              <img src="{{ card_image | image_url: width: 800 }}"
                   srcset="{{ card_image | image_url: width: 400 }} 400w,
                           {{ card_image | image_url: width: 800 }} 800w"
                   sizes="(min-width: 1024px) 33vw, 100vw"
                   alt="" width="800" height="600" loading="lazy" decoding="async">
            {%- endif -%}
          </span>
          <span class="collection-card__veil" aria-hidden="true"></span>
          <span class="collection-card__body">
            <span class="collection-card__title">{{ block.settings.title | default: target.title }}</span>
            {%- if target != blank -%}
              <span class="collection-card__count">{{ 'sections.collection.product_count' | t: count: target.products_count }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Grille de collections",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Nos univers" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Par usage" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Titre affiché (facultatif)" },
        { "type": "image_picker", "id": "image", "label": "Image (facultatif)" },
        { "type": "url", "id": "link", "label": "Lien de secours" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grille de collections",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
