{%- comment -%}
  Search results. Empty state offers a route forward rather than a dead end.
{%- endcomment -%}
<div class="container">
  <header class="page-header">
    <h1 class="page-header__title">
      {%- if search.terms != blank -%}
        {{ 'general.search.results_for' | t: terms: search.terms }}
      {%- else -%}
        {{ 'general.search.title' | t }}
      {%- endif -%}
    </h1>

    <form class="search-panel__form mt-5" action="{{ routes.search_url }}" method="get" role="search"
          style="max-width: 520px;">
      <label class="visually-hidden" for="page-search">{{ 'general.search.title' | t }}</label>
      <input id="page-search" class="input" type="search" name="q" value="{{ search.terms | escape }}"
             placeholder="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="btn btn--primary">{{ 'general.search.submit' | t }}</button>
    </form>
  </header>

  {%- paginate search.results by 24 -%}
    {%- if search.performed and search.results_count > 0 -%}
      <p class="collection-toolbar__count mb-4">
        {{ 'general.search.results_count' | t: count: search.results_count }}
      </p>
      <div class="collection-grid collection-grid--4" data-reveal-group>
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- else -%}
            <article class="product-card">
              <div class="product-card__body">
                <h2 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
                <p class="product-card__meta">{{ item.content | strip_html | truncatewords: 22 }}</p>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a class="pagination__item" href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span class="pagination__item" aria-current="page">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- elsif search.performed -%}
      <div class="empty-state">
        <div class="empty-state__icon">{% render 'icon', name: 'search' %}</div>
        <h2 class="empty-state__title">{{ 'general.search.no_results_title' | t: terms: search.terms }}</h2>
        <p class="empty-state__text">{{ 'general.search.no_results_text' | t }}</p>
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Recherche",
  "settings": []
}
{% endschema %}
