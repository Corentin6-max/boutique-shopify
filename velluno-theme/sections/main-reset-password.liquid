<div class="container auth-card">
  <h1 class="h3">{{ 'customer.reset_password.title' | t }}</h1>
  <p class="muted mt-4">{{ 'customer.reset_password.text' | t }}</p>
  {%- form 'reset_customer_password', class: 'stack mt-5' -%}
    {{ form.errors | default_errors }}
    <div class="field">
      <label class="field__label" for="reset-password">{{ 'customer.reset_password.password' | t }}</label>
      <input class="input" id="reset-password" type="password" name="customer[password]" autocomplete="new-password">
    </div>
    <div class="field">
      <label class="field__label" for="reset-confirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
      <input class="input" id="reset-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password">
    </div>
    <button type="submit" class="btn btn--primary btn--full">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Réinitialisation", "settings": [] }
{% endschema %}
