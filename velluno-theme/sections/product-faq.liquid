{%- comment -%}
  OBJECTION ANSWERED: everything that would otherwise become a support email —
  and the last hesitations before checkout. Emits FAQPage JSON-LD so the
  answers can surface directly in Google.
{%- endcomment -%}
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container container--narrow">
    <div class="section__head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- capture default_title %}{{ 'products.faq.title' | t }}{% endcapture -%}
      <h2 class="h2" id="faq-title">{{ section.settings.title | default: default_title }}</h2>
    </div>

    <div class="accordion" data-accordion="exclusive" data-reveal-group>
      {%- for block in section.blocks -%}
        {%- assign panel_id = section.id | append: '-faq-' | append: forloop.index -%}
        <div class="accordion__item" data-reveal {{ block.shopify_attributes }}>
          <h3>
            <button type="button" class="accordion__trigger" data-accordion-trigger
                    aria-expanded="false" aria-controls="{{ panel_id }}">
              {{ block.settings.question }}
              {% render 'icon', name: 'plus', class: 'accordion__icon' %}
            </button>
          </h3>
          <div class="accordion__panel" id="{{ panel_id }}" data-open="false">
            <div><div class="accordion__content rte">{{ block.settings.answer }}</div></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ produit",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Vos questions" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Questions fréquentes" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ produit" }]
}
{% endschema %}
