{%- comment -%}
  Cart drawer. Re-rendered through the Section Rendering API after every
  mutation, so this file is the single template for both the initial paint
  and every refresh.
{%- endcomment -%}
<aside class="cart-drawer" id="cart-drawer" data-panel data-cart-drawer
       data-section-id="{{ section.id }}" aria-hidden="true"
       role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title">
  <div class="cart-drawer__head">
    <h2 class="cart-drawer__title" id="cart-drawer-title">
      {{ 'cart.drawer_title' | t }}
      <span class="muted small">(<span data-cart-count-label>{{ cart.item_count }}</span>)</span>
    </h2>
    <button type="button" class="icon-btn" data-panel-close aria-label="{{ 'general.accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>

  <div class="cart-drawer__body" data-cart-body>
    <p class="form-status form-status--error" data-cart-error role="alert" hidden></p>

    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <div class="cart-line">
          <a class="cart-line__media media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 200 }}" alt="" width="100" height="100" loading="lazy">
            {%- endif -%}
          </a>
          <div>
            <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
            {%- unless item.product.has_only_default_variant -%}
              <p class="cart-line__variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            <div class="cart-line__foot">
              <div class="qty" data-line-qty data-line-key="{{ item.key }}">
                <button type="button" class="qty__btn" data-qty-step="-1"
                        aria-label="{{ 'cart.quantity_decrease' | t: title: item.product.title }}">
                  {% render 'icon', name: 'minus' %}
                </button>
                <input class="qty__input" type="number" min="0" value="{{ item.quantity }}"
                       aria-label="{{ 'cart.quantity' | t }}">
                <button type="button" class="qty__btn" data-qty-step="1"
                        aria-label="{{ 'cart.quantity_increase' | t: title: item.product.title }}">
                  {% render 'icon', name: 'plus' %}
                </button>
              </div>
              <span class="cart-line__price">{{ item.final_line_price | money }}</span>
            </div>
            <button type="button" class="link small mt-4" data-line-remove="{{ item.key }}"
                    aria-label="{{ 'cart.remove' | t: title: item.product.title }}">
              {% render 'icon', name: 'trash', size: 15 %}<span>{{ 'cart.remove_short' | t }}</span>
            </button>
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="cart-empty">
        <div class="cart-empty__icon">{% render 'icon', name: 'cart' %}</div>
        <h3 class="h4">{{ 'cart.empty_title' | t }}</h3>
        <p class="muted mt-4">{{ 'cart.empty_text' | t }}</p>
        <a class="btn btn--primary mt-6" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}</a>
      </div>
    {%- endif -%}
  </div>

  <div class="cart-drawer__foot" data-cart-foot>
    {%- if cart.item_count > 0 -%}
      {% render 'free-shipping-bar', cart: cart %}

      <div class="cart-total">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span class="cart-total__value">{{ cart.total_price | money }}</span>
      </div>
      <p class="caption">{{ 'cart.taxes_note' | t }}</p>

      <form action="{{ routes.cart_url }}" method="post" class="mt-4">
        <button type="submit" name="checkout" class="btn btn--primary btn--full btn--lg">
          {{ 'cart.checkout' | t }}
        </button>
      </form>
      <a class="btn btn--ghost btn--full mt-4" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
    {%- endif -%}
  </div>
</aside>

{% schema %}
{
  "name": "Tiroir panier",
  "settings": []
}
{% endschema %}
