<div class="container auth-card">
  <h1 class="h3">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer', class: 'stack mt-5' -%}
    {{ form.errors | default_errors }}
    <div class="grid grid--2">
      <div class="field">
        <label class="field__label" for="reg-first">{{ 'customer.register.first_name' | t }}</label>
        <input class="input" id="reg-first" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="reg-last">{{ 'customer.register.last_name' | t }}</label>
        <input class="input" id="reg-last" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
    </div>
    <div class="field">
      <label class="field__label" for="reg-email">{{ 'customer.register.email' | t }}</label>
      <input class="input" id="reg-email" type="email" name="customer[email]" autocomplete="email" required>
    </div>
    <div class="field">
      <label class="field__label" for="reg-password">{{ 'customer.register.password' | t }}</label>
      <input class="input" id="reg-password" type="password" name="customer[password]" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn btn--primary btn--full">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
  <p class="mt-6 small">
    {{ 'customer.register.has_account' | t }}
    <a class="link" href="{{ routes.account_login_url }}">{{ 'customer.register.login' | t }}</a>
  </p>
</div>

{% schema %}
{ "name": "Créer un compte", "settings": [] }
{% endschema %}
