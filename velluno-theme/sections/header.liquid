{%- comment -%}
  Sticky header: burger + search on the left, centred wordmark, account and
  cart on the right. The layout is a three-column grid so the logo stays
  optically centred whatever the number of icons.
{%- endcomment -%}
<header class="header" data-header>
  <div class="container header__inner">
    <div class="header__left">
      <button
        type="button"
        class="icon-btn header__burger"
        aria-controls="nav-drawer"
        aria-expanded="false"
        aria-label="{{ 'general.accessibility.open_menu' | t }}"
        data-panel-open>
        {% render 'icon', name: 'menu' %}
      </button>

      <nav class="header__nav" aria-label="{{ linklists[section.settings.menu].title | default: 'Menu' }}">
        {%- for link in linklists[section.settings.menu].links limit: 4 -%}
          <a class="nav-link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    </div>

    <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 400 }}"
             alt="{{ shop.name | escape }}"
             width="{{ settings.logo_height | times: settings.logo.aspect_ratio | round }}"
             height="{{ settings.logo_height }}"
             style="height: {{ settings.logo_height }}px; width: auto;">
      {%- else -%}
        {% render 'velluno-logo', variant: settings.logo_variant %}
      {%- endif -%}
    </a>

    <div class="header__actions">
      <button
        type="button"
        class="icon-btn"
        aria-controls="search-panel"
        aria-expanded="false"
        aria-label="{{ 'general.accessibility.search' | t }}"
        data-panel-open>
        {% render 'icon', name: 'search' %}
      </button>

      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn" href="{{ routes.account_url }}" aria-label="{{ 'general.accessibility.account' | t }}">
          {% render 'icon', name: 'user' %}
        </a>
      {%- endif -%}

      {%- comment -%}
        Always a real link to /cart: without JS it navigates, with JS the
        drawer intercepts the click. Ctrl/Cmd-click still opens the page.
      {%- endcomment -%}
      <a class="icon-btn" href="{{ routes.cart_url }}" data-cart-open
         aria-label="{{ 'general.accessibility.cart' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- comment -%} Predictive search panel, anchored under the header. {%- endcomment -%}
  <div class="search-panel" id="search-panel" data-panel data-search-panel
       data-search-url="{{ routes.predictive_search_url }}" aria-hidden="true">
    <div class="container">
      <form class="search-panel__form" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="search-input">{{ 'general.search.title' | t }}</label>
        <input
          id="search-input"
          class="input"
          type="search"
          name="q"
          autocomplete="off"
          data-autofocus
          data-search-input
          placeholder="{{ 'general.search.placeholder' | t }}">
        <button type="submit" class="btn btn--primary">{{ 'general.search.submit' | t }}</button>
        <button type="button" class="icon-btn" data-panel-close aria-label="{{ 'general.accessibility.close' | t }}">
          {% render 'icon', name: 'close' %}
        </button>
      </form>

      <div class="search-results" data-search-results hidden aria-live="polite">
        {%- comment -%} Skeleton shown while suggestions load. {%- endcomment -%}
        <div class="search-results__list">
          {%- for i in (1..3) -%}
            <div class="search-result">
              <div class="skeleton skeleton--media"></div>
              <div><div class="skeleton skeleton--title"></div><div class="skeleton skeleton--text" style="width:38%"></div></div>
              <div></div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</header>

{%- comment -%} Mobile navigation drawer. {%- endcomment -%}
<nav class="nav-drawer" id="nav-drawer" data-panel aria-hidden="true"
     aria-label="{{ 'general.accessibility.menu' | t }}">
  <div class="cluster" style="justify-content: space-between; margin-bottom: var(--sp-5);">
    {% render 'velluno-logo', variant: 'wordmark' %}
    <button type="button" class="icon-btn" data-panel-close aria-label="{{ 'general.accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
  </div>

  {%- for link in linklists[section.settings.menu].links -%}
    <a class="nav-drawer__link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
  {%- endfor -%}

  <div class="nav-drawer__meta">
    <p class="small">{% render 'icon', name: 'truck' %} {{ 'shipping.free_threshold_html' | t }}</p>
    <p class="small">{% render 'icon', name: 'return' %} {{ 'shipping.returns_title' | t }}</p>
    <p class="small mt-4">
      <a class="link" href="mailto:{{ settings.contact_email | default: 'contact@velluno.fr' }}">
        {{ settings.contact_email | default: 'contact@velluno.fr' }}
      </a>
    </p>
  </div>
</nav>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
