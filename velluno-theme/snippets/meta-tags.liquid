{%- comment -%}
  Per-page title, description, canonical, hreflang and Open Graph tags.
  Shopify emits its own og: tags in content_for_header only for some objects,
  so we own them here to keep them predictable.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  case request.page_type
    when 'product'
      assign og_type = 'product'
      assign og_image = product.featured_media
    when 'article'
      assign og_type = 'article'
      assign og_image = article.image
    when 'collection'
      assign og_image = collection.featured_image
  endcase
  unless og_image
    assign og_image = settings.share_image
  endunless
-%}
<title>{{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
{%- if og_description %}<meta name="description" content="{{ og_description | strip_html | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
<link rel="alternate" hreflang="fr-FR" href="{{ canonical_url }}">
<link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | escape }}">
<meta property="og:locale" content="fr_FR">
{%- if og_image %}
  <meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif %}
{%- if request.page_type == 'product' %}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | escape }}">
