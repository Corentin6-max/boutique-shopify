{%- comment -%}
  FAQ en accordéon. Les panneaux sont rendus ouverts puis repliés par
  shapewear.js : sans JavaScript, les réponses restent lisibles et indexables.
{%- endcomment -%}
<div class="sw sw-block{% if section.settings.band %} sw-block--band{% endif %}" id="aide">
  <div class="sw__wrap sw__wrap--narrow">
    <div class="sw__section-head{% if section.settings.centered %} sw__section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sw__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="sw__h2">{{ section.settings.heading }}</h2>
    </div>

    <div class="sw-faq__list" data-sw-accordion {% if section.settings.open_first %}data-sw-accordion-open-first{% endif %}>
      {%- for block in section.blocks -%}
        <div class="sw-faq__item" {{ block.shopify_attributes }}>
          <h3>
            <button
              type="button"
              class="sw-faq__q"
              data-sw-acc-trigger
              aria-expanded="true"
              aria-controls="SwFaq-{{ block.id }}">
              <span>{{ block.settings.question }}</span>
              <span class="sw-faq__icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="sw-faq__a" id="SwFaq-{{ block.id }}">{{ block.settings.answer }}</div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="sw-faq__cta">
        {%- if section.settings.cta_note != blank -%}
          <p class="sw-faq__cta-note">{{ section.settings.cta_note }}</p>
        {%- endif -%}
        <a class="sw__btn sw__btn--primary" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.rich_snippets and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- assign reponse = block.settings.answer | strip_newlines | strip_html | replace: '&nbsp;', ' ' | strip -%}
          {%- assign demande = block.settings.question | replace: '&nbsp;', ' ' | strip -%}
          {
            "@type": "Question",
            "name": {{ demande | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ reponse | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ Shapewear",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Questions fréquentes" },
    { "type": "checkbox", "id": "centered", "label": "Titre centré", "default": true },
    { "type": "checkbox", "id": "band", "label": "Fond gris", "default": false },
    { "type": "checkbox", "id": "open_first", "label": "Ouvrir la première question", "default": true },
    { "type": "header", "content": "Rappel d'achat" },
    { "type": "text", "id": "cta_note", "label": "Phrase au-dessus du bouton" },
    { "type": "text", "id": "cta_label", "label": "Texte du bouton" },
    { "type": "text", "id": "cta_link", "label": "Lien du bouton", "default": "#sw-achat" },
    { "type": "header", "content": "Référencement" },
    { "type": "checkbox", "id": "rich_snippets", "label": "Balisage FAQPage (schema.org)", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Votre question" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Votre réponse.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ Shapewear" }]
}
{% endschema %}
