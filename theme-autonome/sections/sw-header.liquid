<header class="sw-header">
  <div class="sw-header__in">
    <a class="sw-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" height="26">
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <nav class="sw-header__nav">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <a class="sw-header__cart" href="{{ routes.cart_url }}">
      Panier <span class="sw-header__count" data-sw-cart-count>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
