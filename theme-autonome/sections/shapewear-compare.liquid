{%- comment -%}
  Tableau comparatif.

  Chaque ligne porte un titre — le bénéfice pour le client — et une sous-ligne
  qui explique par quel mécanisme il est obtenu. C'est cette seconde ligne qui
  fait la différence entre une liste de cases cochées et un argumentaire :
  n'y écrivez que ce que la documentation du fournisseur atteste.
{%- endcomment -%}
<div class="sw sw-block{% if section.settings.band %} sw-block--band{% endif %}">
  <div class="sw__wrap">
    <div class="sw__section-head{% if section.settings.centered %} sw__section-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sw__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="sw__h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="sw__lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="sw-compare__scroll">
      <table class="sw-compare__table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_label }}</th>
            <th scope="col" class="sw-compare__col--us">
              <span class="sw-compare__marque">{{ section.settings.col_us | default: shop.name }}</span>
            </th>
            <th scope="col">
              {{ section.settings.col_a }}
              {%- if section.settings.col_a_sub != blank -%}
                <span class="sw-compare__sub">{{ section.settings.col_a_sub }}</span>
              {%- endif -%}
            </th>
            <th scope="col">
              {{ section.settings.col_b }}
              {%- if section.settings.col_b_sub != blank -%}
                <span class="sw-compare__sub">{{ section.settings.col_b_sub }}</span>
              {%- endif -%}
            </th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">
                {{ block.settings.label }}
                {%- if block.settings.note != blank -%}
                  <span class="sw-compare__why">{{ block.settings.note }}</span>
                {%- endif -%}
              </th>
              {%- assign cells = block.settings.us | append: '||' | append: block.settings.a | append: '||' | append: block.settings.b | split: '||' -%}
              {%- for cell in cells -%}
                {%- assign value = cell | strip -%}
                <td {% if forloop.first %}class="sw-compare__col--us"{% endif %}>
                  {%- if value == 'oui' -%}
                    <span class="sw-mark sw-mark--yes">{% render 'sw-icon', icon: 'check' %}</span>
                    <span class="visually-hidden">Oui</span>
                  {%- elsif value == 'non' -%}
                    <span class="sw-mark sw-mark--no">{% render 'sw-icon', icon: 'cross' %}</span>
                    <span class="visually-hidden">Non</span>
                  {%- else -%}
                    {{ value }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparatif Shapewear",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Comparatif" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pourquoi pas un simple débardeur ?" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "centered", "label": "Titre centré", "default": true },
    { "type": "checkbox", "id": "band", "label": "Fond gris", "default": false },

    { "type": "header", "content": "Colonnes" },
    { "type": "text", "id": "col_label", "label": "Intitulé de la première colonne", "default": "Ce qui compte vraiment" },
    { "type": "text", "id": "col_us", "label": "Votre colonne", "default": "Velluno" },
    { "type": "text", "id": "col_a", "label": "Colonne 2", "default": "Débardeur classique" },
    { "type": "text", "id": "col_a_sub", "label": "Sous-titre colonne 2", "default": "Sans compression" },
    { "type": "text", "id": "col_b", "label": "Colonne 3", "default": "Gaine premier prix" },
    { "type": "text", "id": "col_b_sub", "label": "Sous-titre colonne 3", "default": "Compression uniforme" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Ligne",
      "settings": [
        { "type": "text", "id": "label", "label": "Bénéfice", "default": "Bénéfice pour le client" },
        { "type": "textarea", "id": "note", "label": "Par quel mécanisme (une phrase)" },
        { "type": "text", "id": "us", "label": "Votre colonne (oui / non / texte)", "default": "oui" },
        { "type": "text", "id": "a", "label": "Colonne 2", "default": "non" },
        { "type": "text", "id": "b", "label": "Colonne 3", "default": "non" }
      ]
    }
  ],
  "presets": [{ "name": "Comparatif Shapewear" }]
}
{% endschema %}
