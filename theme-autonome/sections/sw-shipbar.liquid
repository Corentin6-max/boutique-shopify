{%- if section.settings.text != blank -%}
  <div class="sw sw-shipbar">
    <span>{% render 'sw-icon', icon: 'truck' %}{{ section.settings.text }}</span>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau livraison",
  "settings": [
    { "type": "text", "id": "text", "label": "Texte", "default": "Livraison suivie offerte, 8 à 12 jours" }
  ]
}
{% endschema %}
