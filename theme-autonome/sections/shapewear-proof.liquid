{%- comment -%}
  Blocs preuve : une image, une objection levée. Rien de décoratif.
  Le texte vaut à lui seul : un bloc sans photo s'affiche sur toute la
  largeur plutôt que de laisser un cadre vide à côté de lui.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="sw sw-block{% if section.settings.band %} sw-block--band{% endif %}">
  <div class="sw__wrap">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="sw__section-head{% if section.settings.centered %} sw__section-head--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sw__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="sw__h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="sw__lede">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sw-proof">
      {%- for block in section.blocks -%}
        {%- assign alt_text = block.settings.image.alt -%}
        {%- if alt_text == blank -%}{%- assign alt_text = block.settings.heading -%}{%- endif -%}
        {%- liquid
          assign flip = false
          if block.settings.media_side == 'right'
            assign flip = true
          elsif block.settings.media_side == 'auto' and forloop.index0 == 1
            assign flip = true
          elsif block.settings.media_side == 'auto' and forloop.index0 == 3
            assign flip = true
          endif
        -%}
        {%- comment -%}
          L'emplacement image est toujours rendu : sans photo il affiche un
          cadre d'attente, pour que la mise en page image + texte se voie
          dès l'éditeur.
        {%- endcomment -%}
          <section class="sw-proof__row{% if flip %} sw-proof__row--flip{% endif %}" {{ block.shopify_attributes }}>
            <div class="sw-proof__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag:
                   loading: 'lazy',
                   sizes: '(min-width: 900px) 46vw, 92vw',
                   widths: '480, 720, 960, 1200',
                   alt: alt_text,
                   class: 'sw-proof__img' }}
              {%- else -%}
                <p class="sw-proof__placeholder">Emplacement photo<br>Ajoutez l'image de ce bloc.</p>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <p class="sw-proof__caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </div>

            <div class="sw-proof__body">
              {%- if block.settings.eyebrow != blank -%}
                <p class="sw-proof__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="sw-proof__title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="sw-proof__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.points != blank -%}
                <ul class="sw-proof__points">
                  {%- assign points = block.settings.points | newline_to_br | split: '<br />' -%}
                  {%- for point in points -%}
                    {%- assign line = point | strip -%}
                    {%- if line != blank -%}
                      <li>{% render 'sw-icon', icon: 'check' %}<span>{{ line }}</span></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </section>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Preuves Shapewear",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "heading", "label": "Titre de section" },
    { "type": "richtext", "id": "text", "label": "Texte d'introduction" },
    { "type": "checkbox", "id": "centered", "label": "Titre centré", "default": true },
    { "type": "checkbox", "id": "band", "label": "Fond gris", "default": false }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Bloc image + texte",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "select", "id": "media_side", "label": "Côté de la photo", "default": "auto",
          "options": [
            { "value": "auto", "label": "Alterné automatiquement" },
            { "value": "left", "label": "À gauche" },
            { "value": "right", "label": "À droite" }
          ]
        },
        { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
        { "type": "text", "id": "heading", "label": "Titre" },
        { "type": "richtext", "id": "text", "label": "Texte" },
        { "type": "textarea", "id": "points", "label": "Points (un par ligne)" },
        { "type": "text", "id": "caption", "label": "Légende sous la photo" }
      ]
    }
  ],
  "presets": [{ "name": "Preuves Shapewear" }]
}
{% endschema %}
