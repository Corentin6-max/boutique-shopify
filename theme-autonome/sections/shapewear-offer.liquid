{%- comment -%}
  Rappel des packs en page d'accueil.

  Le prix unitaire est lu sur le produit et la dégressivité reproduit la remise
  automatique Shopify — aucun tarif saisi à la main qui pourrait diverger du
  catalogue ou de ce qui sera réellement facturé.
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  assign unit = product.price_min
  assign tiers = section.settings.tiers | split: ','
-%}
<div class="sw sw-block{% if section.settings.band %} sw-block--band{% endif %}">
  <div class="sw__wrap">
    <div class="sw__section-head sw__section-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sw__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="sw__h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="sw__lede">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if product != blank and unit > 0 -%}
      <div class="sw-offer__grid">
        {%- for raw in tiers -%}
          {%- liquid
            assign units = raw | strip | plus: 0
            if units < 1
              assign units = 1
            endif

            assign brut = unit | times: units
            assign net = brut
            if units >= section.settings.discount_min and section.settings.discount_percent > 0
              assign reste = 100 | minus: section.settings.discount_percent
              assign net = brut | times: reste | divided_by: 100
            endif
            assign economie = brut | minus: net
            assign par_unite = net | divided_by: units

            assign featured = false
            if units == section.settings.badge_units
              assign featured = true
            endif
          -%}
          <div class="sw-offer__card{% if featured %} sw-offer__card--featured{% endif %}">
            {%- if featured and section.settings.ribbon != blank -%}
              <span class="sw-offer__ribbon">{{ section.settings.ribbon }}</span>
            {%- endif -%}

            <span class="sw-offer__qty">{{ units }} débardeur{% if units > 1 %}s{% endif %}</span>
            <p class="sw-offer__price">{{ net | money }}</p>
            {%- if economie > 0 -%}
              <span class="sw-offer__was">au lieu de <s>{{ brut | money }}</s></span>
              <span class="sw-offer__unit">{{ par_unite | money }} l'unité</span>
            {%- endif -%}

            <ul class="sw-offer__perks">
              {%- if economie > 0 -%}
                <li>{% render 'sw-icon', icon: 'check' %}<span>Vous économisez {{ economie | money }}</span></li>
                <li>{% render 'sw-icon', icon: 'check' %}<span>Un propre pendant que l'autre est au lavage</span></li>
              {%- else -%}
                <li>{% render 'sw-icon', icon: 'check' %}<span>{{ section.settings.pack_one_note }}</span></li>
              {%- endif -%}
              {%- if units >= 4 -%}
                <li>{% render 'sw-icon', icon: 'check' %}<span>Une couleur pour chaque usage</span></li>
              {%- endif -%}
            </ul>

            <a href="{{ product.url }}" class="sw__btn {% if featured %}sw__btn--primary{% else %}sw__btn--ghost{% endif %} sw__btn--block">
              {{ section.settings.cta_label }}
            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="sw__lede" style="text-align:center;">
        Sélectionnez le produit dans les réglages de cette section.
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Packs Shapewear",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Offres" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un seul, ou de quoi tenir la semaine" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Il se porte à même la peau : il se lave après chaque journée. C'est la seule raison pour laquelle la plupart de nos clients en prennent plusieurs.</p>" },
    { "type": "text", "id": "tiers", "label": "Paliers (séparés par des virgules)", "default": "1,2,4,6" },
    { "type": "number", "id": "discount_percent", "label": "Remise en % appliquée par Shopify", "default": 20 },
    { "type": "number", "id": "discount_min", "label": "À partir de combien d'articles", "default": 2 },
    { "type": "number", "id": "badge_units", "label": "Palier mis en avant", "default": 4 },
    { "type": "text", "id": "ribbon", "label": "Ruban du palier mis en avant", "default": "Le plus populaire" },
    { "type": "text", "id": "pack_one_note", "label": "Mention du pack de 1", "default": "Pour tester la coupe" },
    { "type": "text", "id": "cta_label", "label": "Libellé du bouton", "default": "Choisir ce pack" },
    { "type": "checkbox", "id": "band", "label": "Fond gris", "default": false }
  ],
  "presets": [{ "name": "Packs Shapewear" }]
}
{% endschema %}
